		"/api/notification/notifications": {
			"get": {
				"operationId": "notification_notifications_get",
				"summary": "GET api/notification/notifications",
				"x-oj-file": "notification/api.ts",
				"tags": [
					"notification"
				],
				"responses": {
					"200": {
						"description": "OK",
						"x-oj-response-enforced": false,
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": [
										"code",
										"msg",
										"data"
									],
									"properties": {
										"code": {
											"type": "integer"
										},
										"msg": {
											"type": "string"
										},
										"data": {
											"type": "array",
											"items": {
												"type": "object",
												"required": [
													"id",
													"scope",
													"avatar",
													"date",
													"message",
													"title"
												],
												"properties": {
													"id": {
														"type": "string"
													},
													"scope": {
														"type": "string",
														"enum": [
															"user",
															"broadcast"
														]
													},
													"avatar": {
														"type": "string"
													},
													"date": {
														"type": "string"
													},
													"isRead": {
														"type": "boolean"
													},
													"message": {
														"type": "string"
													},
													"title": {
														"type": "string"
													},
													"link": {
														"type": [
															"string",
															"null"
														]
													},
													"category": {
														"type": "string",
														"enum": [
															"notice",
															"pm",
															"mention"
														]
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
