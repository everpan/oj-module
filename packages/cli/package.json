{
	"name": "@oj-module/cli",
	"type": "module",
	"version": "0.1.8",
	"description": "React Antd Admin 模块工程命令行工具（含预构建宿主 shell-dist）",
	"license": "MIT",
	"exports": {
		".": {
			"browser": "./src/browser-guard.ts",
			"default": "./src/index.ts"
		},
		"./build": {
			"browser": "./src/browser-guard.ts",
			"default": "./src/build.ts"
		},
		"./shared-deps": {
			"browser": "./src/browser-guard.ts",
			"default": "./src/shared-deps.ts"
		},
		"./esm-exports": {
			"browser": "./src/browser-guard.ts",
			"default": "./src/esm-exports.ts"
		},
		"./config": {
			"browser": "./src/browser-guard.ts",
			"default": "./src/config.ts"
		},
		"./manifest": {
			"browser": "./src/browser-guard.ts",
			"default": "./src/manifest.ts"
		},
		"./info": {
			"browser": "./src/browser-guard.ts",
			"default": "./src/info.ts"
		},
		"./shell-dist/*": "./shell-dist/*"
	},
	"bin": {
		"ojm": "./bin/ojm.mjs",
		"ram": "./bin/ram.mjs"
	},
	"files": [
		"bin",
		"shell-dist",
		"src",
		"templates",
		"vendor",
		"!shell-dist/**/*.map"
	],
	"scripts": {
		"build:shell": "tsx shell/scripts/build.mts",
		"prepack": "node scripts/sync-host-versions.mjs"
	},
	"dependencies": {
		"@faker-js/faker": "catalog:",
		"@oj-module/runtime": "workspace:*",
		"@redocly/cli": "catalog:",
		"esbuild": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"yaml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ant-design/cssinjs": "catalog:",
		"@ant-design/icons": "catalog:",
		"@ant-design/pro-components": "catalog:",
		"@dnd-kit/core": "catalog:",
		"@dnd-kit/sortable": "catalog:",
		"@dnd-kit/utilities": "catalog:",
		"@tanstack/react-query": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"ahooks": "catalog:",
		"antd": "catalog:",
		"antd-img-crop": "catalog:",
		"clsx": "catalog:",
		"dayjs": "catalog:",
		"echarts": "catalog:",
		"echarts-for-react": "catalog:",
		"i18next": "catalog:",
		"keepalive-for-react": "catalog:",
		"ky": "catalog:",
		"motion": "catalog:",
		"nprogress": "catalog:",
		"pinyin-pro": "catalog:",
		"react": "catalog:",
		"react-countup": "catalog:",
		"react-dom": "catalog:",
		"react-error-boundary": "catalog:",
		"react-i18next": "catalog:",
		"react-jss": "catalog:",
		"react-router": "catalog:",
		"simplebar-react": "catalog:",
		"spin-delay": "catalog:",
		"tailwind-merge": "catalog:",
		"use-sync-external-store": "catalog:",
		"zustand": "catalog:"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	}
}
