{
	"name": "react-antd-admin",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"packageManager": "pnpm@11.24.0",
	"description": "React Hooks + TypeScript + Ant Design = react-antd-admin",
	"author": "Condor Hero",
	"license": "MIT",
	"homepage": "https://github.com/condorheroblog/react-antd-admin/blob/main/README.md",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/condorheroblog/react-antd-admin.git"
	},
	"bugs": {
		"url": "https://github.com/condorheroblog/react-antd-admin/issues"
	},
	"imports": {
		"#src/*": "./packages/runtime/src/*",
		"#*": "./*"
	},
	"scripts": {
		"dev": "vite --host",
		"build": "NODE_OPTIONS=--max-old-space-size=8192 vite build && tsx scripts/build-modules.ts && tsx scripts/inject-importmap.ts",
		"build:framework": "vite build",
		"build:modules": "tsx scripts/build-modules.ts",
		"create:module": "tsx scripts/create-module.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"analyzer": "vite-bundle-visualizer --output analyzer/stats.html",
		"eslint-config-inspector": "eslint-config-inspector",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "simple-git-hooks",
		"pnpm:install": "pnpm install",
		"npm-check": "taze major -lrw",
		"check:circular-deps": "ds packages/runtime/src --output circular-deps.json",
		"test": "vitest",
		"test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
		"test:e2e:legacy": "E2E_TARGET=legacy playwright test --config tests/e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --ui"
	},
	"dependencies": {
		"@ant-design/icons": "catalog:",
		"@ant-design/pro-components": "catalog:",
		"@dnd-kit/core": "catalog:",
		"@dnd-kit/sortable": "catalog:",
		"@dnd-kit/utilities": "catalog:",
		"@tanstack/react-query": "catalog:",
		"ahooks": "catalog:",
		"antd": "catalog:",
		"antd-img-crop": "catalog:",
		"dayjs": "catalog:",
		"echarts": "catalog:",
		"echarts-for-react": "catalog:",
		"i18next": "catalog:",
		"keepalive-for-react": "catalog:",
		"ky": "catalog:",
		"motion": "catalog:",
		"nprogress": "catalog:",
		"pinyin-pro": "catalog:",
		"react": "catalog:",
		"react-countup": "catalog:",
		"react-dom": "catalog:",
		"react-error-boundary": "catalog:",
		"react-i18next": "catalog:",
		"react-jss": "catalog:",
		"react-router": "catalog:",
		"simplebar-react": "catalog:",
		"spin-delay": "catalog:",
		"tailwind-merge": "catalog:",
		"zustand": "catalog:"
	},
	"devDependencies": {
		"@ant-design/cssinjs": "catalog:",
		"@antfu/eslint-config": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@eslint-react/eslint-plugin": "catalog:",
		"@eslint/config-inspector": "catalog:",
		"@faker-js/faker": "catalog:",
		"@iconify-json/ri": "catalog:",
		"@iconify/tools": "catalog:",
		"@oj-module/runtime": "workspace:*",
		"@playwright/test": "catalog:",
		"@svgr/plugin-jsx": "catalog:",
		"@svgr/plugin-svgo": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/react-query-devtools": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/react": "catalog:",
		"@testing-library/user-event": "catalog:",
		"@types/node": "catalog:",
		"@types/nprogress": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"circular-dependency-scanner": "catalog:",
		"clsx": "catalog:",
		"code-inspector-plugin": "catalog:",
		"esbuild": "catalog:",
		"eslint": "catalog:",
		"eslint-plugin-react-hooks": "catalog:",
		"eslint-plugin-react-refresh": "catalog:",
		"globals": "catalog:",
		"happy-dom": "catalog:",
		"lint-staged": "catalog:",
		"simple-git-hooks": "catalog:",
		"tailwindcss": "catalog:",
		"taze": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"unplugin-icons": "catalog:",
		"use-sync-external-store": "catalog:",
		"vite": "catalog:",
		"vite-bundle-visualizer": "catalog:",
		"vite-plugin-checker": "catalog:",
		"vite-plugin-fake-server": "catalog:",
		"vite-plugin-svgr": "catalog:",
		"vitest": "catalog:",
		"yaml": "catalog:"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged",
		"commit-msg": "npx commitlint --edit"
	},
	"lint-staged": {
		"*": [
			"eslint --fix"
		]
	}
}
