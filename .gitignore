# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.claude/

# 仓库根的 oj vendor 二进制（`ojm init`/`ojm vendor` 落盘）；锚定根目录，
# 不要误伤 packages/cli/bin（cli 的可执行入口要随包发布）
/bin/

# testing
/coverage

# WebStorm
.idea

# production
/build
/dist
# workspace 子包的构建产物（packages/*/dist、apps/*/dist）
dist/
# cli 内置的「预构建宿主」shell-dist 改为构建期生成、不入库（pnpm publish 前由
# 发布脚本 step 2 重建；测试由 tests/global-setup.ts 在缺失时自举 build:shell）
packages/cli/shell-dist/
# cli 内置的 ojm 模块开发文档（docs/devkit 的发布副本）由 prepack 同步、不入库
packages/cli/devkit/
# runtime 的发布产物（dist/runtime.js）改为构建期生成、不入库（同上）

# editor 首方共享包的发布产物（dist/editor.js）随仓库分发。它无法在 oj-module 侧
# 重建——打包需要 plane 大仓的编辑器源码；由 plane 侧
# oj-app/tools/editor-spike 产出、oj-app/scripts/install-ojm.sh 拷入后入库
!packages/editor-standalone/dist/
!packages/editor-standalone/dist/**

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# package lock
package-lock.json
yarn.lock
# pnpm-lock.yaml

# vitepress
**/.vitepress/dist
**/.vitepress/cache

.eslintcache
analyzer
