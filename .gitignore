# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.js
.claude/

bin/

# testing
/coverage

# WebStorm
.idea

# production
/build
/dist
# workspace 子包的构建产物（packages/*/dist、apps/*/dist）
dist/
# shell 是「预构建宿主」，其 dist 为随仓库分发的预置产物（非本地构建输出），需纳入版本管理
!packages/shell/dist/
!packages/shell/dist/**
# P4.4 sourcemap hidden 的 .map 仅供内部栈解析，不发版不入库
packages/shell/dist/**/*.map
# runtime 的发布产物（dist/runtime.js）随仓库分发
!packages/runtime/dist/
!packages/runtime/dist/**

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# package lock
package-lock.json
yarn.lock
# pnpm-lock.yaml

# vitepress
**/.vitepress/dist
**/.vitepress/cache

.eslintcache
analyzer
TODO.md

# ram CLI 临时构建产物（读取模块定义时生成的临时 bundle）
.ram-tmp-*

# e2e
.e2e-legacy/
tests/e2e/test-results/
tests/e2e/playwright-report/
test-results/
