export const schemas = {
	getOrderList: {
		query: z.object({
	page: z.number().int().min(1),
	size: z.number().int().optional(),
}),
		data: z.object({
	list: z.array(z.object({
		id: z.number(),
		order_no: z.string(),
	})),
