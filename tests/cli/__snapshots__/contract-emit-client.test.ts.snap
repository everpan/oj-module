		}
		catch { /* 非 JSON 错误体——回退原错误 */ }
	}
	return e;
}

export type UploadAvatarForm = {
	fields: z.input<(typeof schemas)["uploadAvatar"]["form"]>
	files: { avatar: File | Blob, gallery?: Array<File | Blob> }
};
export type UploadAvatarData = z.infer<(typeof schemas)["uploadAvatar"]["data"]>;

function buildUploadAvatarForm(input: UploadAvatarForm): FormData {
	const fd = new FormData();
	if (input.fields.kind !== undefined) {
		const v = input.fields.kind;
		fd.append("kind", v !== null && typeof v === "object" ? JSON.stringify(v) : String(v));
	}
	if (input.fields.note !== undefined) {
		const v = input.fields.note;
		fd.append("note", v !== null && typeof v === "object" ? JSON.stringify(v) : String(v));
	}
	fd.append("avatar", input.files.avatar);
	for (const file of input.files.gallery ?? [])
		fd.append("gallery", file);
	return fd;
}

export async function uploadAvatar(form: UploadAvatarForm): Promise<UploadAvatarData> {
	const client = ensureReq();
	try {
		const env = await client.post(\`personal-center/upload\`, { body: buildUploadAvatarForm(form) }).json<OjEnvelope<UploadAvatarData>>();
		// 2xx + code!==0 也是业务错误（§6.2 通道 a）：oj 不会这么发，但契约机制的价值恰是防漂移
		if (typeof env.code === "number" && env.code !== 0)
			throw new ContractApiError(env.code, env.msg ?? "业务错误（信封 code 非 0）");
		const data = env.data as UploadAvatarData;
		if (import.meta.env.DEV) {
			const { schemas } = await import("./api.schemas");
			const r = schemas.uploadAvatar.data.safeParse(data);
			if (!r.success)
				throw new ContractApiError(-1, \`[契约违例] uploadAvatar 响应与契约不符：\${r.error.issues.map(i => \`\${i.path.join(".") || "(root)"}: \${i.message}\`).join("; ")}\`);
		}
		return data;
	}
	catch (e) {
		throw await toApiError(e);
	}
}

export type UploadInFolderParams = z.input<(typeof schemas)["uploadInFolder"]["params"]>;
export type UploadInFolderForm = {
	files: { file: File | Blob }
};
export type UploadInFolderData = z.infer<(typeof schemas)["uploadInFolder"]["data"]>;

function buildUploadInFolderForm(input: UploadInFolderForm): FormData {
	const fd = new FormData();
	fd.append("file", input.files.file);
	return fd;
}

export async function uploadInFolder(input: { params: UploadInFolderParams, form: UploadInFolderForm }): Promise<UploadInFolderData> {
	const client = ensureReq();
	try {
		const env = await client.put(\`personal-center/folder/\${encodeURIComponent(String(input.params.id))}/upload\`, { body: buildUploadInFolderForm(input.form) }).json<OjEnvelope<UploadInFolderData>>();
		// 2xx + code!==0 也是业务错误（§6.2 通道 a）：oj 不会这么发，但契约机制的价值恰是防漂移
		if (typeof env.code === "number" && env.code !== 0)
			throw new ContractApiError(env.code, env.msg ?? "业务错误（信封 code 非 0）");
		const data = env.data as UploadInFolderData;
		if (import.meta.env.DEV) {
			const { schemas } = await import("./api.schemas");
			const r = schemas.uploadInFolder.data.safeParse(data);
			if (!r.success)
				throw new ContractApiError(-1, \`[契约违例] uploadInFolder 响应与契约不符：\${r.error.issues.map(i => \`\${i.path.join(".") || "(root)"}: \${i.message}\`).join("; ")}\`);
		}
		return data;
	}
	catch (e) {
		throw await toApiError(e);
	}
}
"
`;

