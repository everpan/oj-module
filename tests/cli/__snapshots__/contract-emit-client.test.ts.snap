}),
	},
	createOrder: {
		body: z.object({
	order_no: z.string().min(1),
}),
		data: z.object({
	id: z.number(),
}),
	},
	updateOrder: {
		params: z.object({
	id: z.number(),
}),
		body: z.object({
	order_no: z.string().optional(),
}),
		data: z.object({
	id: z.number(),
}),
	},
};
"
`;

