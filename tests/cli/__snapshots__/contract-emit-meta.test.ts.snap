exports[`emitOpenapiYaml（AC-D1） > 快照 + 文档骨架 1`] = `
"openapi: 3.1.0
info:
  title: 订单服务
  version: 1.0.0
paths:
  /order/file/{path}:
    get:
      operationId: downloadFile
      description: 下载附件
      parameters:
        - name: path
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: 成功（原始流，非信封）
          content:
            application/octet-stream:
              schema:
                type: string
                format: binary
  /order/item:
    post:
      operationId: createOrder
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                order_no:
                  type: string
                  minLength: 1
              required:
                - order_no
              additionalProperties: false
      responses:
        "200":
          description: 成功（oj 信封：code=0）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                  data:
                    type: object
                    properties:
                      id:
                        type: number
                    required:
                      - id
                    additionalProperties: false
        default:
          description: 业务错误（oj 信封：code 非 0，HTTP status=code）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                required:
                  - code
  /order/item/{id}:
    delete:
      operationId: deleteOrder
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: 成功（oj 信封：code=0）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
        default:
          description: 业务错误（oj 信封：code 非 0，HTTP status=code）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                required:
                  - code
    get:
      operationId: getOrderDetail
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: number
      responses:
        "200":
          description: 成功（oj 信封：code=0）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                  data:
                    type: object
                    properties:
                      id:
                        type: number
                      order_no:
                        type: string
                    required:
                      - id
                      - order_no
                    additionalProperties: false
        default:
          description: 业务错误（oj 信封：code 非 0，HTTP status=code）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                required:
                  - code
  /order/list:
    get:
      operationId: getOrderList
      description: 订单列表
      parameters:
        - name: page
          in: query
          required: true
          schema:
            type: integer
            minimum: 1
            maximum: 9007199254740991
        - name: size
          in: query
          required: false
          schema:
            type: integer
            minimum: -9007199254740991
            maximum: 9007199254740991
      responses:
        "200":
          description: 成功（oj 信封：code=0）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                  data:
                    type: object
                    properties:
                      list:
                        type: array
                        items:
                          type: object
                          properties:
                            id:
                              type: number
                            order_no:
                              type: string
                          required:
                            - id
                            - order_no
                          additionalProperties: false
                      total:
                        type: number
                    required:
                      - list
                      - total
                    additionalProperties: false
        default:
          description: 业务错误（oj 信封：code 非 0，HTTP status=code）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                required:
                  - code
"
`;

exports[`emitOpenapiYaml：multipart/form-data（form 槽） > 快照 + requestBody.content["multipart/form-data"]：文本部件走 JSON Schema、文件部件 binary 1`] = `
"openapi: 3.1.0
info:
  title: 上传服务
  version: 1.0.0
paths:
  /personal-center/upload:
    post:
      operationId: uploadAvatar
      description: 上传头像/附件
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              properties:
                kind:
                  type: string
                note:
                  type: string
                avatar:
                  type: string
                  format: binary
                gallery:
                  type: array
                  items:
                    type: string
                    format: binary
              required:
                - kind
                - avatar
      responses:
        "200":
          description: 成功（oj 信封：code=0）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                  data:
                    type: object
                    properties:
                      url:
                        type: string
                    required:
                      - url
                    additionalProperties: false
        default:
          description: 业务错误（oj 信封：code 非 0，HTTP status=code）
          content:
            application/json:
              schema:
                type: object
                properties:
                  code:
                    type: integer
                  msg:
                    type: string
                required:
                  - code
"
`;

exports[`emitRoutesJson（AC-D9） > 规范化 + 排序 + 字节稳定 1`] = `
"[
	{
		"method": "DELETE",
		"pattern": "order/item/{id}"
